    def test_no_python_list_syntax_in_raw_yaml(self, context_manifest, tmp_path):
        spec = {
            "service_name": "svc",
            "spec": {
                "endpoints": [{
                    "port": "http",
                    "metric_relabelings": [{
                        "source_labels": ["__name__"],
                        "action": "keep",
                    }],
                }],
            },
        }
        result = generate_service_monitor(spec, context_manifest, tmp_path)
        raw = result.output_path.read_text()
        assert "['__name__']" not in raw  # Python list repr must not appear


