# ── Custom filter tests ─────────────────────────────────────────────


class TestYamlBoolFilter:
    def test_true(self):
        assert _yaml_bool(True) == "true"

    def test_false(self):
        assert _yaml_bool(False) == "false"

    def test_rejects_int(self):
        with pytest.raises(TypeError, match="yaml_bool filter requires bool"):
            _yaml_bool(1)

    def test_rejects_string(self):
        with pytest.raises(TypeError, match="yaml_bool filter requires bool"):
            _yaml_bool("true")

    def test_rejects_none(self):
        with pytest.raises(TypeError, match="yaml_bool filter requires bool"):
            _yaml_bool(None)


class TestYamlQuoteFilter:
    def test_simple_string_unquoted(self):
        assert _yaml_quote("simple") == "simple"

    def test_hyphenated_unquoted(self):
        assert _yaml_quote("my-service") == "my-service"

    def test_colon_quoted(self):
        assert _yaml_quote("has: colon") == '"has: colon"'

    def test_hash_quoted(self):
        assert _yaml_quote("version #2") == '"version #2"'

    def test_newline_quoted(self):
        result = _yaml_quote("line1\nline2")
        assert result == '"line1\\nline2"'

    def test_leading_space_quoted(self):
        result = _yaml_quote("  leading")
        assert result.startswith('"')

    def test_trailing_space_quoted(self):
        result = _yaml_quote("trailing  ")
        assert result.endswith('"')

    def test_coerces_int_to_string(self):
        assert _yaml_quote(123) == "123"

    @pytest.mark.parametrize("char", [":", "#", "\\", "\n", "{", "}", "[", "]",
                                       ",", "&", "*", "!", "|", ">", "%", "@", "`"])
    def test_special_char_quoted(self, char):
        result = _yaml_quote(f"has{char}char")
        assert result.startswith('"') and result.endswith('"')


class TestYamlListFilter:
    def test_single_item(self):
        assert _yaml_list(["__name__"]) == '["__name__"]'

    def test_multiple_items(self):
        assert _yaml_list(["__name__", "job"]) == '["__name__", "job"]'

    def test_empty_list(self):
        assert _yaml_list([]) == "[]"

    def test_rejects_string(self):
        with pytest.raises(TypeError, match="yaml_list filter requires list"):
            _yaml_list("not a list")

    def test_rejects_dict(self):
        with pytest.raises(TypeError, match="yaml_list filter requires list"):
            _yaml_list({"key": "value"})


