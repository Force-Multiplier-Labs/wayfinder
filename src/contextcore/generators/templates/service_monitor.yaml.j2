class TestAllOnlineBoutiqueServices:
    """Parametric tests across all 11 Online Boutique services."""

    SERVICES = [
        "adservice", "cartservice", "checkoutservice", "currencyservice",
        "emailservice", "frontend", "loadgenerator", "paymentservice",
        "productcatalogservice", "recommendationservice", "shippingservice",
    ]

    @pytest.mark.parametrize("svc", SERVICES)
    def test_generates(self, svc, context_manifest, tmp_path):
        spec = {"artifact_type": "ServiceMonitor", "service_name": svc}
        result = generate_service_monitor(spec, context_manifest, tmp_path)
        assert result.success is True
        assert result.output_path.exists()
        doc = yaml.safe_load(result.output_path.read_text())
        assert doc["metadata"]["labels"]["contextcore/service"] == svc

    @pytest.mark.parametrize("svc", SERVICES)
    def test_yaml_round_trip(self, svc, context_manifest, tmp_path):
        spec = {"artifact_type": "ServiceMonitor", "service_name": svc}
        result = generate_service_monitor(spec, context_manifest, tmp_path)
        raw = result.output_path.read_text()
        doc1 = yaml.safe_load(raw)
        doc2 = yaml.safe_load(yaml.safe_dump(doc1))
        assert doc1 == doc2