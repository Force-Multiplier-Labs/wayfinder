class TestValidateArtifactSpec:
    def test_valid_minimal_returns_name(self):
        assert _validate_artifact_spec({"service_name": "foo"}) == "foo"

    def test_missing_service_name(self):
        with pytest.raises(ArtifactSpecError, match="service_name must be a string"):
            _validate_artifact_spec({})

    def test_non_string_service_name(self):
        with pytest.raises(ArtifactSpecError, match="service_name must be a string"):
            _validate_artifact_spec({"service_name": 123})

    def test_empty_service_name(self):
        with pytest.raises(ArtifactSpecError, match="non-empty string"):
            _validate_artifact_spec({"service_name": ""})

    def test_whitespace_only_service_name(self):
        with pytest.raises(ArtifactSpecError, match="non-empty string"):
            _validate_artifact_spec({"service_name": "   "})

    def test_spec_not_dict(self):
        with pytest.raises(ArtifactSpecError, match="spec must be a dict"):
            _validate_artifact_spec({"service_name": "x", "spec": "bad"})

    def test_namespace_selector_none_valid(self):
        spec = {"service_name": "x", "spec": {"namespace_selector": None}}
        assert _validate_artifact_spec(spec) == "x"

    def test_namespace_selector_any_valid(self):
        spec = {"service_name": "x", "spec": {"namespace_selector": "any"}}
        assert _validate_artifact_spec(spec) == "x"

    def test_namespace_selector_list_valid(self):
        spec = {"service_name": "x", "spec": {"namespace_selector": ["a"]}}
        assert _validate_artifact_spec(spec) == "x"

    def test_namespace_selector_empty_list_valid(self):
        spec = {"service_name": "x", "spec": {"namespace_selector": []}}
        assert _validate_artifact_spec(spec) == "x"

    def test_namespace_selector_invalid_string(self):
        spec = {"service_name": "x", "spec": {"namespace_selector": "bad"}}
        with pytest.raises(ArtifactSpecError, match="namespace_selector"):
            _validate_artifact_spec(spec)

    def test_namespace_selector_invalid_int(self):
        spec = {"service_name": "x", "spec": {"namespace_selector": 42}}
        with pytest.raises(ArtifactSpecError, match="namespace_selector"):
            _validate_artifact_spec(spec)

    def test_endpoints_not_list(self):
        spec = {"service_name": "x", "spec": {"endpoints": "bad"}}
        with pytest.raises(ArtifactSpecError, match="endpoints must be a list"):
            _validate_artifact_spec(spec)

    def test_endpoint_not_dict(self):
        spec = {"service_name": "x", "spec": {"endpoints": ["bad"]}}
        with pytest.raises(ArtifactSpecError, match=r"endpoints\[0\] must be a dict"):
            _validate_artifact_spec(spec)

    def test_endpoint_missing_port(self):
        spec = {"service_name": "x", "spec": {"endpoints": [{"interval": "30s"}]}}
        with pytest.raises(ArtifactSpecError, match="missing required field 'port'"):
            _validate_artifact_spec(spec)

    def test_endpoint_valid_port(self):
        spec = {"service_name": "x", "spec": {"endpoints": [{"port": "http"}]}}
        assert _validate_artifact_spec(spec) == "x"

    def test_metric_relabelings_not_list(self):
        spec = {
            "service_name": "x",
            "spec": {"endpoints": [{"port": "p", "metric_relabelings": "bad"}]},
        }
        with pytest.raises(ArtifactSpecError, match="metric_relabelings must be a list"):
            _validate_artifact_spec(spec)

    def test_metric_relabeling_not_dict(self):
        spec = {
            "service_name": "x",
            "spec": {"endpoints": [{"port": "p", "metric_relabelings": ["bad"]}]},
        }
        with pytest.raises(ArtifactSpecError, match=r"metric_relabelings\[0\] must be a dict"):
            _validate_artifact_spec(spec)

    def test_source_labels_missing(self):
        spec = {
            "service_name": "x",
            "spec": {"endpoints": [{"port": "p", "metric_relabelings": [{"action": "keep"}]}]},
        }
        with pytest.raises(ArtifactSpecError, match="missing required field 'source_labels'"):
            _validate_artifact_spec(spec)

    def test_source_labels_not_list(self):
        spec = {
            "service_name": "x",
            "spec": {
                "endpoints": [{
                    "port": "p",
                    "metric_relabelings": [{"source_labels": "__name__"}],
                }],
            },
        }
        with pytest.raises(ArtifactSpecError, match="source_labels must be a list"):
            _validate_artifact_spec(spec)


# ── Template context builder tests ──────────────────────────────────


class TestBuildTemplateContext:
    def test_minimal_defaults(self, context_manifest):
        ctx = _build_template_context(
            {"service_name": "cart"}, context_manifest
        )
        assert ctx["name"] == "cart-monitor"
        assert ctx["namespace"] == "online-boutique"
        assert ctx["service_name"] == "cart"
        assert ctx["selector_labels"] == {"app": "cart"}
        assert ctx["source_file"] == "manifest.yaml"
        assert len(ctx["endpoints"]) == 1
        assert ctx["endpoints"][0]["port"] == "metrics"
        assert ctx["additional_labels"] == {}
        assert ctx["additional_annotations"] == {}
        assert isinstance(ctx["derivation"], dict)

    def test_custom_overrides(self, context_manifest):
        ctx = _build_template_context(
            {
                "service_name": "cart",
                "spec": {
                    "name": "custom",
                    "namespace": "ns",
                    "selector_labels": {"k": "v"},
                    "endpoints": [{"port": "grpc"}],
                    "additional_labels": {"a": "b"},
                    "additional_annotations": {"c": "d"},
                    "namespace_selector": "any",
                },
            },
            context_manifest,
        )
        assert ctx["name"] == "custom"
        assert ctx["namespace"] == "ns"
        assert ctx["selector_labels"] == {"k": "v"}
        assert ctx["endpoints"] == [{"port": "grpc"}]
        assert ctx["additional_labels"] == {"a": "b"}
        assert ctx["additional_annotations"] == {"c": "d"}
        assert ctx["namespace_selector"] == "any"

    def test_namespace_falls_back_to_default(self):
        ctx = _build_template_context(
            {"service_name": "x"}, {}
        )
        assert ctx["namespace"] == "default"

    def test_derivation_keys(self, context_manifest):
        ctx = _build_template_context(
            {"service_name": "x"}, context_manifest
        )
        expected_keys = {
            "name_source", "namespace_source", "selector_source",
            "port_source", "interval_source", "path_source",
        }
        assert set(ctx["derivation"].keys()) == expected_keys


