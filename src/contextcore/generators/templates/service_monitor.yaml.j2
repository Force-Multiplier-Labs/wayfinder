class TestMetricRelabelings:
    def test_basic_relabeling(self, context_manifest, tmp_path):
        spec = {
            "service_name": "svc",
            "spec": {
                "endpoints": [{
                    "port": "http",
                    "metric_relabelings": [{
                        "source_labels": ["__name__"],
                        "action": "keep",
                        "regex": "http_requests_total",
                    }],
                }],
            },
        }
        result = generate_service_monitor(spec, context_manifest, tmp_path)
        assert result.success is True
        doc = yaml.safe_load(result.output_path.read_text())
        rel = doc["spec"]["endpoints"][0]["metricRelabelings"][0]
        assert rel["sourceLabels"] == ["__name__"]
        assert rel["action"] == "keep"
        assert rel["regex"] == "http_requests_total"

    def test_multiple_source_labels(self, context_manifest, tmp_path):
        spec = {
            "service_name": "svc",
            "spec": {
                "endpoints": [{
                    "port": "http",
                    "metric_relabelings": [{
                        "source_labels": ["__name__", "job"],
                        "action": "replace",
                        "target_label": "combined",
                        "replacement": "$1_$2",
                    }],
                }],
            },
        }
        result = generate_service_monitor(spec, context_manifest, tmp_path)
        doc = yaml.safe_load(result.output_path.read_text())
        rel = doc["spec"]["endpoints"][0]["metricRelabelings"][0]
        assert rel["sourceLabels"] == ["__name__", "job"]
