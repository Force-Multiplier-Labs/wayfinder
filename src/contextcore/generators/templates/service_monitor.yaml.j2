class TestGenerateServiceMonitor:
    def test_minimal_success(self, minimal_spec, context_manifest, tmp_path):
        result = generate_service_monitor(minimal_spec, context_manifest, tmp_path)
        assert result.success is True
        assert result.artifact_type == "ServiceMonitor"
        assert result.service_name == "cartservice"
        assert result.error is None
        assert result.output_path.exists()

    def test_output_filename(self, minimal_spec, context_manifest, tmp_path):
        result = generate_service_monitor(minimal_spec, context_manifest, tmp_path)
        assert result.output_path.name == "cartservice-service-monitor.yaml"

    def test_valid_yaml_structure(self, minimal_spec, context_manifest, tmp_path):
        result = generate_service_monitor(minimal_spec, context_manifest, tmp_path)
        doc = yaml.safe_load(result.output_path.read_text())
        assert doc["apiVersion"] == "monitoring.coreos.com/v1"
        assert doc["kind"] == "ServiceMonitor"
        assert doc["metadata"]["name"] == "cartservice-monitor"
        assert doc["metadata"]["namespace"] == "online-boutique"

    def test_full_spec_overrides(self, full_spec, context_manifest, tmp_path):
        result = generate_service_monitor(full_spec, context_manifest, tmp_path)
        assert result.success is True
        doc = yaml.safe_load(result.output_path.read_text())
        assert doc["metadata"]["name"] == "cart-mon"
        assert doc["metadata"]["namespace"] == "boutique"
        assert len(doc["spec"]["endpoints"]) == 2
        assert doc["spec"]["endpoints"][0]["scrapeTimeout"] == "10s"
        assert doc["metadata"]["labels"]["team"] == "platform"

    def test_default_endpoint_values(self, minimal_spec, context_manifest, tmp_path):
        result = generate_service_monitor(minimal_spec, context_manifest, tmp_path)
        doc = yaml.safe_load(result.output_path.read_text())
        ep = doc["spec"]["endpoints"][0]
        assert ep["interval"] == "30s"
        assert ep["path"] == "/metrics"
        assert ep["scheme"] == "http"

    def test_default_selector_labels(self, minimal_spec, context_manifest, tmp_path):
        result = generate_service_monitor(minimal_spec, context_manifest, tmp_path)
        doc = yaml.safe_load(result.output_path.read_text())
        assert doc["spec"]["selector"]["matchLabels"] == {"app": "cartservice"}

    def test_standard_labels_present(self, minimal_spec, context_manifest, tmp_path):
        result = generate_service_monitor(minimal_spec, context_manifest, tmp_path)
        doc = yaml.safe_load(result.output_path.read_text())
        labels = doc["metadata"]["labels"]
        assert labels["app.kubernetes.io/name"] == "cartservice"
        assert labels["app.kubernetes.io/component"] == "monitoring"
        assert labels["app.kubernetes.io/managed-by"] == "contextcore"
        assert labels["contextcore/artifact-type"] == "ServiceMonitor"
        assert labels["contextcore/service"] == "cartservice"

    def test_annotations_present(self, minimal_spec, context_manifest, tmp_path):
        result = generate_service_monitor(minimal_spec, context_manifest, tmp_path)
        doc = yaml.safe_load(result.output_path.read_text())
        ann = doc["metadata"]["annotations"]
        assert ann["contextcore/generated-from"] == "manifest.yaml"
        assert ann["contextcore/feature-id"] == "F-005"

    def test_derivation_comments_present(self, minimal_spec, context_manifest, tmp_path):
        result = generate_service_monitor(minimal_spec, context_manifest, tmp_path)
        content = result.output_path.read_text()
        assert "Derivation rules:" in content
        assert "manifest.yaml" in content


class TestErrorHandling:
    def test_missing_service_name_returns_failure(self, context_manifest, tmp_path):
        result = generate_service_monitor(
            {"artifact_type": "ServiceMonitor"}, context_manifest, tmp_path
        )
        assert result.success is False
        assert "service_name" in result.error.lower()
        assert result.service_name == "unknown"

    def test_error_uses_artifact_spec_error(self, context_manifest, tmp_path):
        result = generate_service_monitor(
            {"artifact_type": "ServiceMonitor"}, context_manifest, tmp_path
        )
        assert "ArtifactSpecError" in result.error

    def test_never_raises_with_empty_dict(self, tmp_path):
        result = generate_service_monitor({}, {}, tmp_path)
        assert isinstance(result.success, bool)
        assert result.success is False

    def test_never_raises_with_non_dict(self, tmp_path):
        result = generate_service_monitor("bad input", {}, tmp_path)
        assert result.success is False
        assert result.service_name == "unknown"

    def test_never_raises_with_none(self, tmp_path):
        result = generate_service_monitor(None, {}, tmp_path)
        assert result.success is False


class TestFileOverwriteProtection:
    def test_no_overwrite_without_force(self, minimal_spec, context_manifest, tmp_path):
        r1 = generate_service_monitor(minimal_spec, context_manifest, tmp_path)
        assert r1.success is True

        r2 = generate_service_monitor(
            minimal_spec, context_manifest, tmp_path, force=False
        )
        assert r2.success is False
        assert "already exists" in r2.error

    def test_overwrite_with_force(self, minimal_spec, context_manifest, tmp_path):
        r1 = generate_service_monitor(minimal_spec, context_manifest, tmp_path)
        assert r1.success is True

        r2 = generate_service_monitor(
            minimal_spec, context_manifest, tmp_path, force=True
        )
        assert r2.success is True


